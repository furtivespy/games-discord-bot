# IS_IN_CONTAINER is set by the Docker image. Do not set this locally —
# local runs use ./config.json and ./data; containers use the /data volume.
# IS_IN_CONTAINER=true

# Honeycomb — get your API key at https://ui.honeycomb.io/account
# Leave HONEYCOMB_API_KEY blank to disable tracing locally
OTEL_SERVICE_NAME=discord-bot-inis
HONEYCOMB_API_KEY=

# Discord Embedded App (visual mode). Same Discord application as the bot.
# CLIENT_ID defaults to config.json clientId. CLIENT_SECRET is server-side
# only — never commit it. PUBLIC_BASE_URL is the public HTTPS origin this
# process serves and Discord loads as the Activity URL.
# PORT defaults to 3000 (the image already EXPOSEs it).
CLIENT_ID=
CLIENT_SECRET=
PUBLIC_BASE_URL=
# PORT=3000
