# IS_IN_CONTAINER is set by the Docker image. Do not set this locally —
# local runs use ./config.json and ./data; containers use the /data volume.
# IS_IN_CONTAINER=true

# Honeycomb — get your API key at https://ui.honeycomb.io/account
# Leave HONEYCOMB_API_KEY blank to disable tracing locally
OTEL_SERVICE_NAME=discord-bot-inis
HONEYCOMB_API_KEY=

# QA/dev only. When set (e.g. 1), admin-only slash commands such as /config
# are registered without Discord's Administrator gate so a non-admin test
# account can see and run them. Unset in production.
# QA_UNLOCK_ADMIN_COMMANDS=1
