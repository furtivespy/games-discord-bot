{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // ship-pr.json carries // comments, which its own tool allows but strict JSON does not.
    // Impeccable is vendored third-party skill code (minified bundles), not ours to lint.
    "includes": ["**", "!**/dist", "!**/*.sqlite*", "!bun.lock", "!.github/ship-pr.json", "!**/skills/impeccable"]
  },
  // Lint only for now. The formatter is off because ~300 existing files would
  // be rewritten; turning it on is a separate mass-format change.
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      // Legacy baseline (~180 hits). Kept visible as warnings (`bun run
      // lint:warnings`) so a change is not forced into semantics-changing
      // rewrites (`==` -> `===`, hoisting inner functions). Promote to
      // "error" once cleaned up. `bun run lint` fails on errors only.
      "suspicious": {
        "noDoubleEquals": "warn"
      },
      "correctness": {
        "noInnerDeclarations": "warn"
      }
    }
  }
}
